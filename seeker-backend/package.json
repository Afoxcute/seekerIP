{
  "name": "hedgehog",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "print-db": "tsx lookup-db.ts",
    "issuer:firehose:events": "node ./dist/events/issuer.firehose.js",
    "issuer:index:events": "node ./dist/events/issuer.indexer.js",
    "issuer": "pnpm run issuer:firehose:events & pnpm run issuer:index:events",
    "lender:firehose:events": "node ./dist/events/lender.firehose.js",
    "lender:index:events": "node ./dist/events/lender.indexer.js",
    "price:provider": "node ./dist/providers/price-provider.js",
    "timeseries:provider": "node ./dist/providers/timeseries-provider.js",
    "providers": "pnpm run price:provider & pnpm run timeseries:provider",
    "lender": "pnpm run lender:firehose:events & pnpm run lender:index:events",
    "index": "pnpm run issuer & pnpm run lender",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "clean-db": "rm -rf ./local-store/sqlite/sqlite.db && tsx ./events/clean.ts && rm -rf ./db/migrations && pnpm run generate && pnpm run migrate",
    "studio": "drizzle-kit studio",
    "build": "rm -rf ./dist && tsup",
    "start": "pnpm run index & pnpm run providers",
    "server": "tsx server.ts",
    "dev:server": "tsx --watch server.ts",
    "test:yakoa": "tsx scripts/test-yakoa-integration.ts",
    "setup:env": "node setup-env.js",
    "deploy:arbitration": "hardhat run scripts/deploy-arbitration.cjs --network hedera_testnet",
    "token-prep": "tsx ./tests/Issuer/setup-token.ts",
    "sync:all": "tsx -e \"import { thirdwebDataSyncService } from './lib/thirdweb-data-sync-service'; thirdwebDataSyncService.syncAllContracts().then(() => process.exit(0)).catch(console.error)\"",
    "sync:ip-assets": "tsx -e \"import { thirdwebDataSyncService } from './lib/thirdweb-data-sync-service'; thirdwebDataSyncService.syncIPAssetManagerV2().then(() => process.exit(0)).catch(console.error)\"",
    "sync:locks": "tsx -e \"import { thirdwebDataSyncService } from './lib/thirdweb-data-sync-service'; thirdwebDataSyncService.syncIPAssetLocker().then(() => process.exit(0)).catch(console.error)\"",
    "sync:hbar-tokens": "tsx -e \"import { thirdwebDataSyncService } from './lib/thirdweb-data-sync-service'; thirdwebDataSyncService.syncHBAREquivalentToken().then(() => process.exit(0)).catch(console.error)\"",
    "sync:arbitration": "tsx -e \"import { thirdwebDataSyncService } from './lib/thirdweb-data-sync-service'; thirdwebDataSyncService.syncIntellectualPropertyArbitration().then(() => process.exit(0)).catch(console.error)\"",
    "index:events": "tsx -e \"import { comprehensiveIndexer } from './events/comprehensive-indexer'; comprehensiveIndexer.startIndexing().catch(console.error)\"",
    "process:events": "tsx -e \"import { comprehensiveIndexer } from './events/comprehensive-indexer'; comprehensiveIndexer.processQueuedEvents().then(() => process.exit(0)).catch(console.error)\"",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "db:clear": "node scripts/clear-database.cjs",
    "db:clear-advanced": "node scripts/advanced-clear-database.cjs",
    "test:data-sync": "node scripts/test-data-sync.cjs",
    "test:thirdweb-sync": "node scripts/test-thirdweb-sync.cjs",
    "test:simple-sync": "node scripts/test-simple-sync.cjs",
    "test:bigint-fix": "node scripts/test-bigint-fix.cjs",
    "test:single-asset": "node scripts/test-single-asset.cjs",
    "test:contract-exists": "node scripts/test-contract-exists.cjs",
    "test:frontend-method": "node scripts/test-frontend-method.cjs",
    "test:metadata-uris": "node scripts/test-metadata-uris.cjs",
    "show:metadata": "node scripts/show-metadata.cjs",
    "test:metadata-parsing": "node scripts/test-metadata-parsing.cjs",
    "db:show": "node scripts/show-database-data.cjs",
    "db:show-contracts": "node scripts/show-contract-data.cjs",
    "db:summary": "node scripts/database-summary.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hashgraph/sdk": "^2.60.1",
    "@libsql/client": "^0.15.1",
    "@openzeppelin/contracts": "^5.2.0",
    "@prisma/client": "^5.22.0",
    "@types/better-sqlite3": "^7.6.12",
    "axios": "^1.8.4",
    "better-sqlite3": "^11.9.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "ethers": "^6.13.5",
    "express": "^4.18.2",
    "node-lmdb": "^0.10.1",
    "solc": "^0.8.29",
    "thirdweb": "^5.0.0",
    "tsup": "^8.4.0",
    "viem": "^2.37.8"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.1",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.5",
    "hardhat": "^2.26.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
