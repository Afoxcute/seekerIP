# ===========================================
# SEEKER BACKEND ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your actual values

# ===========================================
# HEDERA CONFIGURATION (REQUIRED)
# ===========================================
# Get these from your Hedera Portal account
# https://portal.hedera.com/
HEDERA_OPERATOR_ID=0.0.123456
HEDERA_OPERATOR_KEY=302e020100300506032b657004220420abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_TESTNET_URL=https://testnet.hashio.io/api
HEDERA_MAINNET_URL=https://mainnet.hashio.io/api

# ===========================================
# PRIVATE KEY (REQUIRED FOR DEPLOYMENT)
# ===========================================
# Your Hedera account private key (same as HEDERA_OPERATOR_KEY but without the prefix)
PRIVATE_KEY=abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# ===========================================
# SMART CONTRACT ADDRESSES
# ===========================================
# IP Asset Management Contracts
IP_ASSET_MANAGER_V2_ADDRESS=0xA20Ba7d4aD1bb40D46f3B9F8b4e722848C68d80a
IP_ASSET_NFT_ADDRESS=0x227f1cDcBeb442F07e4A2119ab0AD83C21E6fFE5
IP_ASSET_MANAGER_ENHANCED_ADDRESS=0x77A7aB9f54b2132B51acF6f36A624b9dcf264ce3
IP_ASSET_MANAGER_ADDRESS=0x30BD264110f71916f338B132EdD4d35C38138468

# Arbitration Contract (Deployed)
ARBITRATION_CONTRACT_ADDRESS=0x5C7424821131c2314F9f9494f01DDb14C9904A62

# ===========================================
# YAKOA INFRINGEMENT BACKEND SERVICE
# ===========================================
# Get these from your Yakoa account
YAKOA_BACKEND_URL=https://api.yakoa.com
YAKOA_API_KEY=your_yakoa_api_key_here
YAKOA_SUBDOMAIN=your_subdomain
YAKOA_NETWORK=hedera_testnet

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# SQLite database (default)
DATABASE_URL=file:./prisma/dev.db

# Alternative: PostgreSQL
# DATABASE_URL=postgresql://username:password@localhost:5432/seeker_db

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3001
NODE_ENV=development

# ===========================================
# HEDERA CONSENSUS SERVICE (HCS) CONFIGURATION
# ===========================================
# For arbitration system HCS integration
HCS_TOPIC_ID=0.0.123456
HCS_OPERATOR_ID=0.0.123456
HCS_OPERATOR_KEY=302e020100300506032b657004220420abcdef1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# ===========================================
# API KEYS (OPTIONAL)
# ===========================================
# For external services
HEDERA_API_KEY=your_hedera_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_FILE=./logs/seeker-backend.log

# ===========================================
# CORS CONFIGURATION
# ===========================================
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# ARBITRATION SYSTEM CONFIGURATION
# ===========================================
# Dispute resolution settings
DISPUTE_BOND_AMOUNT=1000000000
VOTING_PERIOD_SECONDS=604800
CHALLENGE_PERIOD_SECONDS=259200
MIN_STAKE_TO_VOTE=10000000
ARBITRATOR_FEE=50000000

# ===========================================
# NOTIFICATION CONFIGURATION (OPTIONAL)
# ===========================================
# Email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Discord webhook for notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url

# ===========================================
# MONITORING CONFIGURATION (OPTIONAL)
# ===========================================
# Health check endpoints
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Metrics collection
ENABLE_METRICS=true
METRICS_PORT=9090

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# JWT secret for API authentication
JWT_SECRET=your_super_secret_jwt_key_here

# API rate limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=900000

# ===========================================
# DEVELOPMENT CONFIGURATION
# ===========================================
# Enable debug mode
DEBUG=true
VERBOSE_LOGGING=true

# Skip certain validations in development
SKIP_VALIDATION=false

# ===========================================
# PRODUCTION CONFIGURATION
# ===========================================
# For production deployment
# NODE_ENV=production
# LOG_LEVEL=warn
# DEBUG=false
# VERBOSE_LOGGING=false



